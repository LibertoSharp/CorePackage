<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="background" style="flex-grow: 1; flex-direction: row; width: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-left: 5px; background-color: rgba(0, 0, 0, 0);">
        <ui:Label text="name" name="name" style="flex-grow: 1; align-self: center; -unity-text-align: middle-left; margin-bottom: 4px;"/>
        <ui:Label text="value" name="value" style="-unity-text-align: middle-right; white-space: pre; flex-direction: column; flex-wrap: nowrap; align-items: auto; align-self: center; flex-grow: 1; margin-bottom: 4px;"/>
    </ui:VisualElement>
</ui:UXML>
